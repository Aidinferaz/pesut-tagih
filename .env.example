# Copy to .env.local and fill in. Never commit real values.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys). Locally: `npx supabase start` prints them. ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:58321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row level security; used by cron and webhooks.
SUPABASE_SECRET_KEY=

# Development only: email magic-link sign-in (links land in Mailpit, localhost:58324).
DEV_EMAIL_LOGIN=false
