# Copy to .env.local and fill in. Never commit real values.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys). Locally: `npx supabase start` prints them. ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:58321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row level security; used by cron and webhooks.
SUPABASE_SECRET_KEY=

# Development only: email magic-link sign-in (links land in Mailpit, localhost:58324).
DEV_EMAIL_LOGIN=false

# --- Pesut's AI (leave AI_PROVIDER empty to switch AI features off) ---
# azure | openrouter | mock (mock = free canned answers, development and tests only)
AI_PROVIDER=
# Microsoft Foundry OpenAI v1 endpoint, e.g. https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
# For AI_PROVIDER=openrouter (model ids then look like openai/gpt-5-mini)
OPENROUTER_API_KEY=
# Azure deployment names (or OpenRouter model ids)
AI_AGENT_MODEL=gpt-5-mini
AI_FAST_MODEL=gpt-5-nano
# Per person, per day (Asia/Makassar)
AI_DAILY_CHATS=40
AI_DAILY_SCANS=10

# --- Daily job (Vercel Cron sends it as a Bearer token) ---
CRON_SECRET=

# --- Telegram bot from @BotFather (leave empty to switch Telegram off) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string; register it with setWebhook (see docs/deploy.md)
TELEGRAM_WEBHOOK_SECRET=

# --- Web Push (npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- WhatsApp via Fonnte (dedicated number only; it may get banned) ---
WA_GATEWAY=none
FONNTE_TOKEN=
